{
  "name": "hotel-offer-orchestrator",
  "version": "1.0.0",
  "description": "Aggregates overlapping hotel offers from two mock suppliers using Temporal, caches in Redis",
  "main": "dist/api/server.js",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start:api": "node dist/api/server.js",
    "start:worker": "node dist/temporal/worker.js",
    "dev:api": "tsx watch src/api/server.ts",
    "dev:worker": "tsx watch src/temporal/worker.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@temporalio/activity": "^1.26.0",
    "@temporalio/client": "^1.26.0",
    "@temporalio/worker": "^1.26.0",
    "@temporalio/workflow": "^1.26.0",
    "express": "^5.3.0",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@temporalio/testing": "^1.26.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
