    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ],
              "query": []
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('both suppliers reported up', () => { pm.expect(b.checks.supplierA.status).to.eql('up'); pm.expect(b.checks.supplierB.status).to.eql('up'); });",
                  "pm.test('redis + temporal up', () => { pm.expect(b.checks.redis.status).to.eql('up'); pm.expect(b.checks.temporal.status).to.eql('up'); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}